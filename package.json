{
  "name": "geedit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "lint": "eslint --ext .js,.vue src",
    "start": "vite",
    "preview": "vite preview",
    "release:web": "gh-pages -d dist"
  },
  "dependencies": {
    "@geekeren/markdown-it-implicit-figures": "^0.9.2",
    "axios": "^1.18.1",
    "clipboard": "^2.0.4",
    "core-js": "^3.1.2",
    "debounce": "^1.2.0",
    "highlight.js": "^10.4.1",
    "markdown-it": "^14.3.0",
    "markdown-it-abbr": "^1.0.4",
    "markdown-it-deflist": "^2.0.3",
    "markdown-it-emoji": "^1.4.0",
    "markdown-it-footnote": "^3.0.2",
    "markdown-it-images-preview": "^1.0.1",
    "markdown-it-mark": "^3.0.0",
    "markdown-it-sub": "^1.0.0",
    "markdown-it-sup": "^1.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "gh-pages": "^6.3.0",
    "lint-staged": "^9.4.2",
    "sass": "^1.89.2",
    "vite": "8.1.4"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.js": [
      "eslint",
      "git add"
    ],
    "*.vue": [
      "eslint",
      "git add"
    ]
  }
}
